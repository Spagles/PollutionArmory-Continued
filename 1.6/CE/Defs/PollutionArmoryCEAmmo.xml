      <thingDefs>
        <li>Steel</li>
        <li>Wastepack</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <PA_CE_Ammo_PSR>25</PA_CE_Ammo_PSR>
    </products>
    <workAmount>1800</workAmount>
  </RecipeDef>

  <RecipeDef ParentName="AmmoRecipeBase">
    <defName>MakePA_CE_Ammo_Sprayer</defName>
