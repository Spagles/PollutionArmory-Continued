<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>Pollution_Sprayer</defName>
    <label>Pollution Sprayer</label>
    <description>This weapon can emit a large volume of specially treated toxicsubstances, inflicting continuous acidic burns on enemies withoutcausing any pollution. Furthermore, it can fire contaminationshells that stun the enemies and summon the Hive.</description>
    <graphicData>
      <texPath>PS</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.6</drawSize>
    </graphicData>

    <uiIconScale>1.3</uiIconScale>
    <soundInteract>Interact_Rifle</soundInteract>
    <!--材料-->
    <costList>
        <Steel>80</Steel>
        <ComponentSpacer>8</ComponentSpacer>
        <Plasteel>100</Plasteel>
        <Wastepack>60</Wastepack>
    </costList>
    <thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <Mass>4</Mass>
      <AccuracyTouch>0.60</AccuracyTouch>
      <AccuracyShort>0.50</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
      <Flammability>0.5</Flammability>
    </statBases>
    <weaponTags Inherit="False">
      <li>DGB</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <recipeMaker>
    <!--建造-->
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <researchPrerequisite>ChargedShot</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <displayPriority>510</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>PS_Bullets</defaultProjectile>
        <warmupTime>1.2</warmupTime>
        <burstShotCount>30</burstShotCount>
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
        <ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius>
        <range>35</range>
        <soundCast>PSS</soundCast>
        <stopBurstWithoutLos>true</stopBurstWithoutLos>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <!--近战。工具-->
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
   <!--能力-->
    <comps Inherit="False">
      <li Class="CompProperties_EquippableAbilityReloadable">
        <abilityDef>Pollution_hive</abilityDef>
        <maxCharges>2</maxCharges>
        <soundReload>Interact_Rifle</soundReload>
        <chargeNoun>Reloading</chargeNoun>
        <ammoDef>Wastepack</ammoDef>     
        <ammoCountPerCharge>5</ammoCountPerCharge>
        <baseReloadTicks>60</baseReloadTicks>
      </li>

      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li Class="CompProperties_Biocodable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponGun</nameMaker>
        <descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
    </comps>

    <generateCommonality>0</generateCommonality>
  </ThingDef>

  <!--弹药-->
  <ThingDef ParentName="BaseBullet">
    <defName>PS_Bullets</defName>
    <label>PS_Bullets</label>
    <graphicData>
      <texPath>PS_Bullets</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>AcidBurn</damageDef>
      <damageAmountBase>8</damageAmountBase>
      <stoppingPower>7</stoppingPower>
      <armorPenetrationBase>1</armorPenetrationBase>
      <speed>40</speed>
      <!-- <arcHeightFactor>1</arcHeightFactor> -->
    </projectile>
  </ThingDef>
  <!--子子弹-->







</Defs>