          </li>
        </grains>      
        <volumeRange>40~45</volumeRange>      
        <pitchRange>0.9940217~1.084783</pitchRange>      
      </li>
    </subSounds>
  </SoundDef>

                   <!--M 200-->
  <AbilityDef>
    <defName>Pollution_MZOOS</defName>
    <label>Projectile</label>
    <description>Electromagnetic Projectile</description>
    <iconPath>UI/M200_P_UI</iconPath>

    <aiCanUse>true</aiCanUse>
    <warmupStartSound>M_SQ_A</warmupStartSound>
    
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>50</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      <warmupTime>1.5</warmupTime>    
      <soundCast>M_SH</soundCast>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>Pollution_MZOOS_A</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <!--子弹-->
  <ThingDef ParentName="BaseBullet">
    <defName>Pollution_MZOOS_A</defName>
    <label>Pollution_MZOOS_A</label>
    <graphicData>
      <texPath>M_bullets</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <speed>180</speed>
      <damageDef>Bomb</damageDef>
      <postExplosionGasType>ToxGas</postExplosionGasType>
      <soundExplode>M_hit</soundExplode>
      <explosionRadius>1.9</explosionRadius>
      <damageAmountBase>150</damageAmountBase>
      <armorPenetrationBase>10</armorPenetrationBase>
      <shadowSize>1.2</shadowSize>
      <!-- <explosionDelay>1</explosionDelay> -->
      <postExplosionSpawnThingDef>Pollution_MZOOS_B</postExplosionSpawnThingDef>
			<postExplosionSpawnChance>0.06</postExplosionSpawnChance>
			<postExplosionSpawnThingCount>1</postExplosionSpawnThingCount>
    </projectile>
  </ThingDef>

	<ThingDef ParentName="BaseBullet">
		<defName>Pollution_MZOOS_B</defName>
		<label>Pollution_MZOOS_B</label>
		<graphicData>
			<texPath>Pollution_bomb</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>

		<thingClass>PollutionWweapons.Projectile_WR</thingClass>
		<projectile>
      <damageDef>EMP</damageDef>
			<damageAmountBase>5</damageAmountBase>
			<explosionDelay>1</explosionDelay>
			<speed>150</speed>
			<explosionRadius>1</explosionRadius>
			<flyOverhead>true</flyOverhead>
      <postExplosionGasType>ToxGas</postExplosionGasType>
			<soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
			<soundExplode>Se</soundExplode>
			<soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
			<soundAmbient>MortarRound_Ambient</soundAmbient>
      <screenShakeFactor>0.1</screenShakeFactor>
		</projectile>
	</ThingDef>

