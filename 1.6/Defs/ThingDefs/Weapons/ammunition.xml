  <AbilityDef>
    <defName>Pollution_XMS</defName>
    <label>grenade X3</label>
    <description>Launch three grenades that can cause pollution.</description>
    <iconPath>UI/grenadeT</iconPath>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <!-- <verbClass>Verb_CastAbility</verbClass> -->
