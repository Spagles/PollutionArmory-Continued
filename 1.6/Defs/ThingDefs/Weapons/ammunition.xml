<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbilityDef>
    <defName>Pollution_grenade</defName>
    <label>grenade</label>
    <description>Launch one grenade that can cause pollution.</description>
    <iconPath>UI/grenade_A</iconPath>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>25</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      <warmupTime>1.5</warmupTime>
      <soundCast>AK_L</soundCast>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>Pollution_grenade_B</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Pollution_grenade_B</defName>
    <label>Pollution_grenade_B</label>
    <graphicData>
      <texPath>grenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <speed>40</speed>
      <damageDef>Bomb</damageDef>
      <postExplosionGasType>ToxGas</postExplosionGasType>
      <armorPenetrationBase>4</armorPenetrationBase>
      <damageAmountBase>40</damageAmountBase>
      <soundExplode>AK_B</soundExplode>
      <explosionRadius>3</explosionRadius>
      <preExplosionSpawnChance>0.3</preExplosionSpawnChance>
      <ai_IsIncendiary>false</ai_IsIncendiary>
      <arcHeightFactor>0.55</arcHeightFactor>
      <shadowSize>0.6</shadowSize>
      <explosionDelay>5</explosionDelay>
      <postExplosionSpawnThingDef>Pollution_A</postExplosionSpawnThingDef>
			<postExplosionSpawnChance>0.2</postExplosionSpawnChance>
			<postExplosionSpawnThingCount>1</postExplosionSpawnThingCount>
    </projectile>
  </ThingDef>

  <SoundDef>
    <defName>AK_B</defName> 
    <context>MapOnly</context>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>      
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>AK_B</clipPath>
          </li>
        </grains>      
        <volumeRange>40~50</volumeRange>      
        <pitchRange>0.9940217~1.084783</pitchRange>      
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>Se</defName> 
    <context>MapOnly</context>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>      
        <grains>
          <li Class="AudioGrain_Clip">
