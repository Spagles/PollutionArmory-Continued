			<postExplosionSpawnChance>0.2</postExplosionSpawnChance>
			<postExplosionSpawnThingCount>1</postExplosionSpawnThingCount>
    </projectile>
  </ThingDef>

<!--Pollution_Sprayer-->
  <AbilityDef>
    <defName>Pollution_hive</defName>
    <label>Summoning hive</label>
    <description>Launching the stored pollution waste at a high altitude can summon the insect nest.</description>
    <iconPath>UI/Hive</iconPath>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>40</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      <warmupTime>2</warmupTime>
      <soundCast>moz</soundCast>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>Pollution_hive_B</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Pollution_hive_B</defName>
    <label>Pollution_hive_B</label>
    <graphicData>
      <texPath>SP_B</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
		<thingClass>PollutionWweapons.Projectile_Hive</thingClass>	
    <projectile>
      <speed>100</speed>
      <damageDef>Stun</damageDef>
      <stoppingPower>20</stoppingPower>
      <postExplosionGasType>ToxGas</postExplosionGasType>
      <armorPenetrationBase>4</armorPenetrationBase>
      <damageAmountBase>40</damageAmountBase>
      <soundExplode>moz_B</soundExplode>
      <explosionRadius>1</explosionRadius>
      <arcHeightFactor>0.55</arcHeightFactor>
      <shadowSize>1.2</shadowSize>
      <explosionDelay>10</explosionDelay>
      <postExplosionSpawnThingDef>TunnelHiveSpawner</postExplosionSpawnThingDef>
      <!-- <postExplosionSpawnThingDef>Hive</postExplosionSpawnThingDef> -->
			<postExplosionSpawnChance>0.5</postExplosionSpawnChance>

    </projectile>
  </ThingDef>




