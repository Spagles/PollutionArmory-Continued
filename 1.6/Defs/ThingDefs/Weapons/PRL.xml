<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseGun">
    <defName>PRL</defName>
    <label>Pollution Rocket Launcher</label>
    <description>The Disposable Pollution Rocket Launcher is a portable weapon designed for single use, capable of firing rockets containing pollutants.</description>
    <!-- <possessionCount>3</possessionCount> -->
    <tickerType>Normal</tickerType>
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>PRL</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.7</drawSize>

    </graphicData>

    <uiIconScale>1.2</uiIconScale>
    <soundInteract>Interact_Rifle</soundInteract>
    <!--材料-->
    <costList>
        <Steel>50</Steel>
        <ComponentIndustrial>1</ComponentIndustrial>
        <Wastepack>15</Wastepack>
    </costList>
    <statBases>
      <WorkToMake>35000</WorkToMake>
      <Mass>4</Mass>
      <AccuracyTouch>0.70</AccuracyTouch>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.85</AccuracyMedium>
      <AccuracyLong>0.80</AccuracyLong>
      <RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
      <Flammability>0.5</Flammability>
    </statBases>
    <weaponTags Inherit="False">
      <li>DGB</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedHeavy</li>
      <li>LongShots</li>
    </weaponClasses>
    <recipeMaker>
    <!--建造-->
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <researchPrerequisite>Mortars</researchPrerequisite>  <!--研究-->
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <displayPriority>510</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_ShootOneUse</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>PRL_bullets</defaultProjectile>
        <forcedMissRadius>3.2</forcedMissRadius>
        <warmupTime>4</warmupTime>
        <ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius>
        <range>36</range>
        <soundCast>PRL_L</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <onlyManualCast>true</onlyManualCast>
        <stopBurstWithoutLos>false</stopBurstWithoutLos>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <muzzleFlashScale>14</muzzleFlashScale>
      </li>
    </verbs>
    <!--近战。工具-->
    <tools>
      <li>
        <label>limb</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <rotateInShelves>false</rotateInShelves>

  </ThingDef>
  <!--弹药-->
  <ThingDef ParentName="BaseBullet">
    <defName>PRL_bullets</defName>
    <label>PRL_bullets</label>
    <graphicData>
      <texPath>PRL_bullets</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>Bomb</damageDef>
      <explosionRadius>3</explosionRadius>
      <damageAmountBase>50</damageAmountBase>
      <speed>50</speed>
      <arcHeightFactor>2</arcHeightFactor>
      <soundExplode>PRL_B</soundExplode>
      <postExplosionSpawnThingDef>Pollution_A</postExplosionSpawnThingDef>
			<postExplosionSpawnChance>0.1</postExplosionSpawnChance>
			<postExplosionSpawnThingCount>1</postExplosionSpawnThingCount>
    </projectile>
  </ThingDef>
  <!--子子弹-->




<!--声音-->





</Defs>